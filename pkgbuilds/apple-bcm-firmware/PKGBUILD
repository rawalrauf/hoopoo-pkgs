# Maintainer: Rawal Rauf <rawalbaloch78@gmail.com>

pkgname=apple-bcm-firmware
pkgver=14.0
pkgrel=1
pkgdesc='Wi-Fi and Bluetooth firmware from macOS Big Sur for T2 and M1 Macs'
arch=('any')
url='https://wiki.t2linux.org/guides/wifi-bluetooth/'
license=('custom:Proprietary')
conflicts=('apple-bcm-firmware-fetcher')
source=("https://github.com/rawalrauf/hoopoo-pkgs/releases/download/apple-bcm-firmware-${pkgver}/apple-bcm-firmware-${pkgver}.tar.gz")
sha256sums=('SKIP')  # Will be updated after first upload

package() {
  cp -r "$srcdir/usr" "$pkgdir/"
  
  install -Dm644 /dev/stdin "$pkgdir/usr/share/licenses/$pkgname/LICENSE" <<EOF
This package contains proprietary firmware extracted from macOS Big Sur.
Apple Inc. retains all rights to this firmware.

Redistribution is done for the purpose of enabling hardware functionality
on T2 and M1 Macs running Linux. Users should have a valid macOS license.
EOF
}
