  # - hoopoo-revoked: list of revoked key fingerprints (one per line)
  # install -Dm644 hoopoo-trusted "$pkgdir/usr/share/pacman/keyrings/hoopoo-trusted"
  # install -Dm644 hoopoo-revoked "$pkgdir/usr/share/pacman/keyrings/hoopoo-revoked"
}
