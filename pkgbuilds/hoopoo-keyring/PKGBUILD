# Maintainer: Hoopoo
pkgname=hoopoo-keyring
pkgver=1.0.0
pkgrel=4
pkgdesc='Hoopoo Linux PGP keyring'
arch=('any')
url='https://github.com/rawalrauf/hoopoo-pkgs'
license=('GPL-3.0-or-later')
source=('hoopoo.gpg'
        'hoopoo-trusted')
sha256sums=('0b2f3e0692ff4cfb4f51301de659ffcda6c6bb804bed10ab9c2a51229c929767'
            'SKIP')

package() {
  install -Dm644 hoopoo.gpg "$pkgdir/usr/share/pacman/keyrings/hoopoo.gpg"
  install -Dm644 hoopoo-trusted "$pkgdir/usr/share/pacman/keyrings/hoopoo-trusted"
}
